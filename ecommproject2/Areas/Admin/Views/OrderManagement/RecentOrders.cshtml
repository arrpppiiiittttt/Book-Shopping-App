@model IEnumerable<ecommproject2.Models.OrderHeader>

@{
    ViewData["Title"] = "Recent Orders";
}

<h2 class="my-3">Recent Orders</h2>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Order ID</th>
            <th>Order Date</th>
            <th>Customer Name</th>
            <th>Phone Number</th>
            <th>Reorder</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.OrderDate.ToString("dd-MM-yyyy HH:mm")</td>
                <td>@order.Name</td>
                <td>@order.PhoneNumber</td>
                <td>
                    <form asp-area="Customer" asp-controller="Cart" asp-action="Reorder" method="post">
                        <input type="hidden" name="orderId" value="@order.Id" />
                        <button type="submit" class="btn btn-primary">Reorder</button>
                    </form>

                </td>
            </tr>
        }
    </tbody>
</table>
