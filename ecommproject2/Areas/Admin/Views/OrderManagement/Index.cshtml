<form method="get" asp-action="Index" class="row mb-4">
    <div class="col-md-3">
        <label>From:</label>
        <input type="date" name="fromDate" class="form-control" value="@Context.Request.Query["fromDate"]" />
    </div>
    <div class="col-md-3">
        <label>To:</label>
        <input type="date" name="toDate" class="form-control" value="@Context.Request.Query["toDate"]" />
    </div>
    <div class="col-md-3 align-self-end">
        <button type="submit" class="btn btn-primary">Filter</button>
    </div>
</form>

<table class="table table-bordered table-striped table-hover text-center">
    <thead>
        <tr>
            <th>Order Id</th>
            <th>Order Date</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone Number</th>
            <th>Total</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.OrderDate.ToShortDateString()</td>
                <td>@order.Name</td>
                <td>@order.ApplicationUser.Email</td>
                <td>@order.PhoneNumber</td>
                <td>$@order.OrderTotal</td>
                <td>@order.OrderStatus</td>
                <td>
                    <form method="post" asp-action="UpdateStatus" style="display:inline;">
                        <input type="hidden" name="orderId" value="@order.Id" />

                        @if (order.OrderStatus == "Pending")
                        {
                            <button type="submit" name="newStatus" value="Approved" class="btn btn-sm btn-success">Approve</button>
                            <button type="submit" name="newStatus" value="Cancelled" class="btn btn-sm btn-danger">Cancel</button>
                        }
                        else if (order.OrderStatus == "Approved")
                        {
                            <button type="submit" name="newStatus" value="Processing" class="btn btn-sm btn-warning">Start Processing</button>
                        }
                        else if (order.OrderStatus == "Processing")
                        {
                            <button type="submit" name="newStatus" value="Shipped" class="btn btn-sm btn-primary">Ship</button>
                        }
                        else if (order.OrderStatus == "Shipped")
                        {
                            
                            <span class="text-success">Completed</span>
                        }
                        else if (order.OrderStatus == "Cancelled")
                        {
                            <button type="submit" name="newStatus" value="Refunded" class="btn btn-sm btn-primary">Refund</button>
                        }
                        else
                        {
                            <span class="text-muted">Done</span>
                        }
                        <a asp-action="Details" asp-route-orderId="@order.Id" class="btn btn-sm btn-info">Details</a>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
